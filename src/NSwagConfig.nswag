      "json": "{\r\n  \"openapi\": \"3.0.4\",\r\n  \"info\": {\r\n    \"title\": \"PhoenixKC.WebAPI\",\r\n    \"version\": \"1.0\"\r\n  },\r\n  \"paths\": {\r\n    \"/example\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"ExampleEndpoints\"\r\n        ],\r\n        \"operationId\": \"GetAllExamples\",\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"array\",\r\n                  \"items\": {\r\n                    \"$ref\": \"#/components/schemas/ExampleDto\"\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"ExampleEndpoints\"\r\n        ],\r\n        \"operationId\": \"CreateExample\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ExampleDto\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"ExampleEndpoints\"\r\n        ],\r\n        \"operationId\": \"UpdateExample\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ExampleDto\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/example/{id}\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"ExampleEndpoints\"\r\n        ],\r\n        \"operationId\": \"GetExampleById\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ExampleDto\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"delete\": {\r\n        \"tags\": [\r\n          \"ExampleEndpoints\"\r\n        ],\r\n        \"operationId\": \"DeleteExample\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"id\",\r\n            \"in